{
  "name": "nikka",
  "version": "0.1.5",
  "description": "Bls spain booking helper",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON_BUILD,ELECTRON -c cyan,yellow,magenta \"vite\" \"tsc --build tsconfig.electron.json --force --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:5173 dist-electron/main.js && node scripts/electron-dev.mjs\"",
    "typecheck": "vue-tsc --noEmit && tsc --project tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && tsc --project tsconfig.electron.json",
    "start": "electron . --production",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@unocss/reset": "^66.7.5",
    "@vueuse/core": "^14.4.0",
    "@vueuse/sound": "^2.1.3",
    "appwrite": "^26.2.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "electron-dl-manager": "^4.2.3",
    "electron-serve": "^3.0.1",
    "form-data": "^4.0.6",
    "node-appwrite": "^27.1.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.2.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.9",
    "wait-on": "^8.0.5"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "vue-demi@0.14.10": true
  }
}
